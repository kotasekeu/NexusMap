{block content}
	<h1>Detail projektu</h1>

	<div class="card mt-4">
		<div class="card-header">
			Informace o projektu
		</div>
		<div class="card-body">
			<p><strong>ID projektu:</strong> {$projectDetail->project_id}</p>
			<p><strong>Název projektu:</strong> {$projectDetail->name}</p>
			<p><strong>UID hash:</strong> {$projectDetail->uid_hash}</p>
			<p><strong>Zákazník ID:</strong> {$projectDetail->customer_id}</p>
			<p><strong>Analýza dokončena:</strong> {if $projectDetail->analysis_done}Ano{else}Ne{/if}</p>
			<p><strong>Datum vytvoření:</strong> {$projectDetail->added|date:'j.n.Y'}</p>
		</div>
	</div>
{if ! empty($json)}
	<div class="card mt-4">
		<div class="card-header">
			Nastavení SOM
		</div>
		<div class="card-body">
			<table class="table table-striped">
    <thead>
        <tr>
            <th>Nastavení</th>
            <th>Hodnota</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Vybrané sloupce</td>
            <td>{implode(', ', $json->selected_columns)}</td>
        </tr>
        <tr>
            <td>Kategoriální sloupce</td>
            <td>{implode(', ', $json->categorical_columns)}</td>
        </tr>
        <tr>
            <td>Sloupce pro analýzu</td>
            <td>{implode(', ', $json->analysis_columns)}</td>
        </tr>
        <tr>
            <td>Legenda - sloupec</td>
            <td>{$json->legend_column}</td>
        </tr>
        <tr>
            <td>Legenda - titulek</td>
            <td>{$json->legend_title}</td>
        </tr>
        <tr>
            <td>Ošetření NaN hodnot</td>
            <td>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Sloupec</th>
                            <th>Hodnota</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach $json->nan_replacement as $column => $value}
                            <tr>
                                <td>{$column}</td>
                                <td>{$value}</td>
                            </tr>
                        {/foreach}
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
{/if}
		</div>
	</div>

	<a href="{$basePath}/userFiles/{$projectDetail->uid_hash}/input.csv" target="_blank">Vstupní CSV</a>
	<br />
	<a href="{$basePath}/userFiles/{$projectDetail->uid_hash}/processed.csv" target="_blank">Zpracované CSV</a>
	<br /><br /><br />
	<img src="{$basePath}/userFiles/{$projectDetail->uid_hash}/visualize.jpg" alt="Visualised data" />
{/block}
