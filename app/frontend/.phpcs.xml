<?xml version="1.0"?>
<ruleset name="ERP">
	<description>Kódování podle PSR-12 s taby místo mezer</description>

	<!-- Použití standardů -->
	<rule ref="PSR12"/>

	<!-- Nastavení použití tabů místo mezer pro odsazení -->
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="1"/>
			<property name="tabIndent" value="true"/>
		</properties>
	</rule>

	<!-- Složky, které analyzovat -->
	<file>app</file>

	<!-- Vyloučení složek -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>var/*</exclude-pattern>
	<exclude-pattern>log/*</exclude-pattern>
</ruleset>