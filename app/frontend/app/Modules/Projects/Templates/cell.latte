{layout '../../../Common/Templates/@layout.latte'}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			<div class="page-title mb-3 d-flex justify-content-between align-items-center">
				<h4>Detail clusteru &mdash; Neuronu {$cell_id}
					<br /><small class="text-primary">{$projectDetail->name}</small>
				</h4>
				<a n:href="Projects:statsData, project_id => $projectDetail->project_id" class="btn btn-success">Zobrazit celkovou analýzu</a>
			</div>
		</div>
		<div class="container-fluid">
			<div class="row">
				<div class="col-sm-12">
					<div class="card">
						<div class="blog-single card-body">
							<div class="blog-box blog-details">
								<div class="blog-details">
									<p class="text-muted">Zobrazení jednoho neuronu (clusteru) po organizaci dat pomocí samo-organizační mapy (SOM). Každý neuron reprezentuje skupinu podobných záznamů. V některých případech se v rámci jednoho clusteru může objevit záznam, který se statisticky výrazně liší – tzv. *extrém*.</p>
									<p class="text-muted">Například pokud je v clusteru 20 pracovních cest do Německa a jedna do Bulharska, je Bulharsko extrém. V jiném clusteru ale může být situace opačná. Extrém tedy závisí na kontextu ostatních hodnot v dané skupině.</p>
									<!-- Extremní případy -->
									<div class="row mb-4">
										<div class="col-12">
											<div class="card border-danger">
												{if ! empty($cellDetail['extremes'])}
													<div class="card-header text-danger"><strong>Extrémní hodnoty v clusteru ({count($cellDetail['extremes'])})</strong></div>
													<div class="card-body table-responsive">
														<table class="table table-striped table-hover table-sm">
															<thead>
																<tr>
																	{if !empty($cellDetail['extremes'])}
																		{var $firstExtremeRecord = reset($cellDetail['extremes'])}
																		{if $firstExtremeRecord}
																			{foreach $firstExtremeRecord as $col => $value}
																				{continueIf ! in_array($col, $projectDetail->project_settings->selected_columns)}
																				<th>{$col}</th>
																			{/foreach}
																		{/if}
																	{/if}
																</tr>
															</thead>
															<tbody>
																{foreach $cellDetail['extremes'] as $record}
																	<tr>
																		{foreach $record as $col => $value}
																			{continueIf ! in_array($col, $projectDetail->project_settings->selected_columns)}
																			{var $note = ''}
																			{var $class = ''}
																			{if isset($cellDetail['numerical_stats'][$col])}
																				{var $val = floatval($value)}
																				{var $min = $cellDetail['numerical_stats'][$col]['min']}
																				{var $max = $cellDetail['numerical_stats'][$col]['max']}
																				{var $avg = $cellDetail['numerical_stats'][$col]['avg']}
																				{if $val === $min}
																					{var $note = ' (min)'}
																					{var $class = 'text-success fw-bold'}
																				{elseif $val === $max}
																					{var $note = ' (max)'}
																					{var $class = 'text-danger fw-bold'}
																				{else}
																					{var $delta = round($val - $avg, 2)}
																					{var $relDelta = round(($delta / abs($avg)) * 100, 1)}
																					{if abs($delta) >= 1}
																						{var $class = 'text-muted'}
																						{var $note = ' (Δ '.$delta.')'}
																						{if abs($relDelta) >= 50}
																							{var $class = 'text-danger fw-bold'}
																							{var $note = ' (Δ '.$delta.', '.$relDelta.'%)'}
																						{elseif abs($relDelta) >= 20}
																							{var $class = 'text-warning fw-bold'}
																							{var $note = ' (Δ '.$delta.', '.$relDelta.'%)'}
																						{/if}
																					{/if}
																				{/if}
																			{/if}
																			<td class="{$class}" style="white-space: nowrap" title="Extrémní hodnota">{if $value == ""}-{else}{$value}{/if} <br />{$note}</td>
																		{/foreach}
																	</tr>
																{/foreach}
															</tbody>
														</table>
														<p class="small text-muted mt-2">Tyto záznamy byly označeny jako odlehlé na základě výrazné odlišnosti od ostatních hodnot v clusteru (např. pomocí směrodatné odchylky).</p>
													</div>
												{/if}
											</div>
										</div>
									</div>
									{if ! empty($cellDetail['records'])}
									<!-- Všechny záznamy -->
									<div class="row mb-4">
										<div class="col-12">
											<div class="card">
												<div class="card-header"><strong>Všechny záznamy v clusteru ({count($cellDetail['records'])})</strong></div>
												<div class="card-body table-responsive">
													<table class="table table-striped table-sm">
														<thead>
														<tr>
															{foreach reset($cellDetail['records']) as $key => $val}
																{continueIf ! in_array($key, $projectDetail->project_settings->selected_columns)}
																<th>{$key}</th>
															{/foreach}
														</tr>
														</thead>
														<tbody>
														<!-- Všechny záznamy -->
														{foreach $cellDetail['records'] as $id => $record}
															<tr class="{isset($cellDetail['extremes'][$id]) ? 'table-danger' : ''}">
																{foreach $record as $key => $value}
																	{continueIf ! in_array($key, $projectDetail->project_settings->selected_columns)}
																	<td {ifset $cellDetail['extremes'][$id]} title="Součást extrémního záznamu"{/ifset}>{if $value == ""}-{else}{$value}{/if}</td>
																{/foreach}
															</tr>
														{/foreach}
														</tbody>
													</table>
													<p class="small text-muted mt-2">Záznamy seskupené tímto neuronem na mapě. Záznamy označeny jako extrémní jsou zvýrazněny červeně.</p>
												</div>
											</div>
										</div>
									</div>
									{/if}
									{if ! empty($cellDetail['numerical_stats'])}
									<!-- Statistika numerických proměnných -->
									<div class="row mb-4">
										<div class="col-12">
											<div class="card">
												<div class="card-header"><strong>Statistiky numerických proměnných</strong></div>
												<div class="card-body table-responsive">
													<table class="table table-striped table-sm table-hover">
														<thead>
														<tr>
															<th>Proměnná</th>
															<th>Min <small class="text-muted">(cluster / soubor)</small></th>
															<th>Max <small class="text-muted">(cluster / soubor)</small></th>
															<th>Průměr <small class="text-muted">(cluster / soubor)</small></th>
															<th>Medián <small class="text-muted">(cluster / soubor)</small></th>
														</tr>
														</thead>
														<tbody>
														{foreach $cellDetail['numerical_stats'] as $col => $stats}
															{var $g = isset($globalStats['numerical'][$col]) ? $globalStats['numerical'][$col] : ['min' => '-', 'max' => '-', 'avg' => '-', 'median' => '-']}
															<tr>
																<td>{$col}</td>
																<td title="{$col}: min">{$stats['min']} <span class="text-muted">({$g['min']})</span></td>
																<td title="{$col}: max">{$stats['max']} <span class="text-muted">({$g['max']})</span></td>
																<td title="{$col}: avg">{$stats['avg']} <span class="text-muted">({$g['avg']})</span></td>
																<td title="{$col}: median">{$stats['median']} <span class="text-muted">({$g['median']})</span></td>
															</tr>
														{/foreach}
														</tbody>
													</table>

													<p class="small text-muted mt-2">
														Hodnoty v závorkách označují statistiku pro celý vstupní dataset. Slouží k porovnání konkrétního clusteru s celkovým rozložením dat.
													</p>
												</div>
											</div>
										</div>
									</div>
									{/if}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{/block}