{if ! empty($json)}
	<div class="card mt-4">
		<div class="card-header">
			Nastavení SOM
		</div>
		<div class="card-body">
			<table class="table table-striped">
				<thead>
				<tr>
					<th>Nastavení</th>
					<th>Hodnota</th>
				</tr>
				</thead>
				<tbody>
				<tr>
					<td>Vybrané sloupce</td>
					<td>{implode(', ', $json->selected_columns)}</td>
				</tr>
				<tr>
					<td>Kategoriální sloupce</td>
					<td>{implode(', ', $json->categorical_columns)}</td>
				</tr>
				<tr>
					<td>Sloupce pro analýzu</td>
					<td>{implode(', ', $json->analysis_columns)}</td>
				</tr>
				<tr>
					<td>Legenda - sloupec</td>
					<td>{$json->legend_column}</td>
				</tr>
				<tr>
					<td>Legenda - titulek</td>
					<td>{$json->legend_title}</td>
				</tr>
				<tr>
					<td>Ošetření NaN hodnot</td>
					<td>
						<table class="table table-bordered">
							<thead>
							<tr>
								<th>Sloupec</th>
								<th>Hodnota</th>
							</tr>
							</thead>
							<tbody>
							{foreach $json->nan_replacement as $column => $value}
								<tr>
									<td>{$column}</td>
									<td>{$value}</td>
								</tr>
							{/foreach}
							</tbody>
						</table>
					</td>
				</tr>
				</tbody>
			</table>
		</div>
	</div>
{/if}