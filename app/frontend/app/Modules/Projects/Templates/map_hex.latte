{layout '../../../Common/Templates/@layout.latte'}
{block head}
	<link rel="stylesheet" type="text/css" href="{$baseUrl}/assets/css/map.css">	
{/block}

{block content}
	<div class="page-body">
		<div class="container-fluid">
            {if $mapName === 'mqe-history'}
                <div class="map-container hex-map " style="background-image: url('{$baseUrl}/userFiles/{$projectDetail->uid_hash}/visualization/{$mapName}.png');"></div>
            {else}
                <div class="map-container hex-map grid-size-{$projectDetail->som_settings->m}" id="map" data-size="{$projectDetail->som_settings->m|noescape}" style="background-image: url('{$baseUrl}/userFiles/{$projectDetail->uid_hash}/visualization/{$mapName}.png');"></div>
                <div class="map-tooltip" id="tooltip"></div>
            {/if}
		</div>
	</div>
{/block}

{block scripts}
	{if $mapName !== 'mqe-history'}
		<script>
			$(function() {
				const $map = $('#map');
				const $tooltip = $('#tooltip');
				const gridSize = {$projectDetail->som_settings->m};
				const cellData = {$clustersWithData|noescape};
				const cellLinkJs = {$cellLink};
				let tooltipTimeout;

				function showTooltip(cell, event) {
					clearTimeout(tooltipTimeout);
					const d = cellData[$(cell).data('id')];
					if (!d) {
						$tooltip.hide();
						return;
					}

					let tooltipContent = `<strong>Neuron</strong> ${ $(cell).data('id')}<br/><br />`;
					tooltipContent += `<strong>Počet záznamů:</strong> ${ d.records_counts}<br/>`;
					tooltipContent += `<strong>Počet extrémů:</strong> ${ d.extremes_counts}<br/>`;
					tooltipContent += '<br><strong>Průměrné hodnoty:</strong><br>';
					
					for (const [key, value] of Object.entries(d.numerical_stats)) {
						tooltipContent += `<strong>${ key}:</strong> ${ value.toFixed(2)}<br/>`;
					}

					$tooltip
						.html(tooltipContent)
						.css({
							'left': event.clientX,
							'top': event.clientY
						})
						.stop(true, true)
						.show();
				}

				function hideTooltip() {
					tooltipTimeout = setTimeout(() => {
						$tooltip.hide();
					}, 100);
				}

				// Vytvoření hexagonální mřížky
				let baseHexWidth, baseHexHeight, initialVerticalOffsetPct;

				switch (gridSize) {
					case 10:
						baseHexWidth = 9.5;
						baseHexHeight = 11.4;
						initialVerticalOffsetPct = 3.5; // Původní hodnota, zdá se OK pro 10x10
						break;
					case 20:
						baseHexWidth = 4.75;
						baseHexHeight = 5.7;
						initialVerticalOffsetPct = baseHexHeight * 0.3; // Upravený offset
						break;
					case 30:
						baseHexWidth = 3.1666;
						baseHexHeight = 3.8;
						initialVerticalOffsetPct = baseHexHeight * 0.2; // Upravený offset, menší pro hustší mřížku
						break;
					default:
						baseHexWidth = 9.5; // Fallback na 10x10
						baseHexHeight = 11.4;
						initialVerticalOffsetPct = 3.5;
				}

				const horizontalSpacing = baseHexWidth; // Horizontální mezera mezi hexagony
				const verticalSpacing = baseHexHeight * 0.795; // Vertikální mezera mezi řádky

				for (let i = 0; i < gridSize; i++) {
					const isOddRow = i % 2 === 1;
					const verticalPosition = initialVerticalOffsetPct + (i * verticalSpacing);
					
					for (let j = 0; j < gridSize; j++) {
						const id = `${ i}_${ j}`; // ID ve formátu "řádek_sloupec"
						const horizontalPosition = (j * horizontalSpacing) + (isOddRow ? horizontalSpacing / 2 : 0);
						
						const $cell = $('<div/>', {
							'class': 'hex-cell',
							'data-id': id
						}).css({
							'left': `${ horizontalPosition}%`,
							'top': `${ verticalPosition}%`
						});

						// Přidání třídy pro červený rámeček, pokud neuron obsahuje extrémy
						const neuronData = cellData[id];
						if (neuronData && neuronData.extremes_counts > 0) {
							$cell.addClass('has-extremes');
						}

						$cell
							.on('mouseenter', function(e) {
								showTooltip(this, e);
							})
							.on('mouseleave', hideTooltip)
							.on('click', function() {
								const cellId = $(this).data('id');
								if (cellLinkJs) {
									window.location.href = cellLinkJs + "&cell_id=" + cellId;
								} else {
									alert('Chybí odkaz pro detail buňky.');
								}
							});
						$map.append($cell);
					}
				}

				// Aktualizace pozice tooltipu při pohybu myši
				$map.on('mousemove', 'div.hex-cell', function(e) {
					if($tooltip.is(':visible')) {
						$tooltip.css({
							'left': e.clientX,
							'top': e.clientY
						});
					}
				});
			});
		</script>
	{/if}
{/block}