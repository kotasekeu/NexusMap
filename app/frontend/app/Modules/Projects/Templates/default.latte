{layout '../../../Common/Templates/@layout.latte'}

{block content}

<div class="page-body">
    <div class="container-fluid">
        <div class="page-title">
            <div class="row">
                <div class="col-md-6">
                    <h4> Přehled projektů </h4>
                </div>
                <div class="col-md-6 project-list">
                    <div class="form-group mb-0 me-0"></div><a class="btn btn-primary" n:href="Projects:create"> <i data-feather="plus-square"> </i>Vytvořit nový projekt</a>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="row project-cards">
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-body">
                        <div class="tab-content" id="top-tabContent">
                            <div class="tab-pane fade show active" id="top-home" role="tabpanel" aria-labelledby="top-home-tab">
                                <div class="row">
                                    {if ! empty($projects)}
                                        {foreach $projects as $project}
                                            {include ./project.latte, projectDetail => $project}
                                        {/foreach}
                                    {else}
                                        <div class="alert alert-info">
                                            <p>Žádné projekty nebyly nalezeny.</p>
                                        </div>
                                    {/if}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}
