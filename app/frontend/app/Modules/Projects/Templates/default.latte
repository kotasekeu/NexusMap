{block content}
	<h1>Seznam projektu</h1>

	<table class="table table-bordered">
		<thead>
		<tr>
			<th>Sloupec</th>
			<th>Hodnota</th>
		</tr>
		</thead>
		<tbody>
		{foreach $json->nan_replacement as $column => $value}
			<tr>
				<td>{$column}</td>
				<td>{$value}</td>
			</tr>
		{/foreach}
		</tbody>
	</table>

{/block}
