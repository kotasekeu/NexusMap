{block content}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<h1>Projekty</h1>

{if $projects}
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Hash</th>
                <th>Název projektu</th>
                <th>Zákazník ID</th>
                <th>Stav analýzy</th>
                <th>Výsledek ID</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            {foreach $projects as $project}
                <tr>
                    <td>{$project['project_id']}</td>
                    <td>{$project['uid_hash']}</td>
                    <td>{$project['name']}</td>
                    <td>{$project['customer_id']}</td>
                    <td>
                        {if $project['analysis_done']}
                            <span class="badge bg-success">Dokončeno</span>
                        {else}
                            <span class="badge bg-warning">Probíhá</span>
                        {/if}
                    </td>
                    <td>{$project['result_id']}</td>
                    <td>
                        <a href="{plink Projects:detail, $project['project_id']}" class="btn btn-sm btn-primary">
                            Detail
                        </a>
                    </td>
                </tr>
            {/foreach}
        </tbody>
    </table>
{else}
    <div class="alert alert-info">
        <p>Žádné projekty nebyly nalezeny.</p>
    </div>
{/if}


{/block}
