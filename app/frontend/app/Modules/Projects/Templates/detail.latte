{layout '../../../Common/Templates/@layout.latte'}

{block content}
<div class="page-body">
	<div class="container-fluid">
		<div class="page-title">
			<div class="row">
				<div class="col-6">
					<h4>Detail projektu</h4>
				</div>
				<div class="col-md-6 project-list">
					{if $projectDetail->ready_to_analyze == 0}
						<a class="btn btn-primary" n:href="Projects:edit, project_id => $projectDetail->project_id"> <i data-feather="plus-square"> </i>Upravit projekt</a>
						<a class="btn btn-warning" n:href="Projects:editSom, project_id => $projectDetail->project_id"> <i data-feather="settings"> </i>Upravit nastavení SOM</a>
					{/if}
					<a class="btn btn-danger" n:href="delete!, project_id => $projectDetail->project_id"  onclick="return confirm('Opravdu chcete smazat tento projekt?');"> <i data-feather="plus-cros"> </i>Odstranit projekt</a>
				</div>
			</div>
		</div>
	</div>
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-12">
				<div class="card">
					<div class="blog-single card-body">
						<div class="blog-box blog-details">
							<div class="blog-details">
								<h4>
									#{$projectDetail->project_id} {$projectDetail->name}
									{if $projectDetail->status == 1}
										<a n:href="Projects:map, $projectDetail->project_id" class="btn btn-success">Detail mapy</a>
										<a n:href="Projects:statsData, $projectDetail->project_id" class="btn btn-primary">Zobrazit analýzu</a>
									{/if}
									{if $projectDetail->ready_to_analyze == 0}
										<a class="btn btn-warning" n:href="submit!, project_id => $projectDetail->project_id"> <i data-feather="plus-cros"> </i>Spustit analýzu</a>
									{/if}
								</h4>
								<div class="single-blog-content-top">
									<div class="card mt-4">
										<div class="card-body">
											<div class="row">
												<div class="col-md-6">
													<p><strong>UID hash:</strong> {$projectDetail->uid_hash}</p>
													{if $projectDetail->status == 1}
														<p><span class="badge badge-success">Analýza byla dokončena</span></p>
													{/if}
													{if $projectDetail->status == 0 && $projectDetail->ready_to_analyze == 1}
														<p>
															<span class="badge badge-warning">Projekt byl odeslán k analýze</span> <br />
															<em>Hned, až na Váš projekt vyjde řada, bude analyzován a informace se zde zobrazí.</em>
														</p>
													{/if}



													<p><strong>Datum vytvoření:</strong> {$projectDetail->added|date:'j.n.Y'}</p>
													
													{if ! empty($projectDetail->project_settings)}
														<div class="card mt-4">
															<div class="card-header">
																<h5>Nastavení parametrů projektu</h5>
															</div>
															<div class="card-body">
																<table class="table table-striped">
																	<thead>
																		<tr>
																			<th>Popis</th>
																			<th>Hodnota</th>
																		</tr>
																	</thead>
																	<tbody>
																		{foreach $projectDetail->project_settings as $key => $value}
																			{continueIf ! isset($projectConfigDescription[$key])}
																			<tr>
																				<td><strong>{$projectConfigDescription[$key]}</strong></td>
																				<td>
																					{if is_array($value)}
																						{implode(', ', $value)}
																					{elseif is_bool($value)}
																						{if $value}Ano{else}Ne{/if}
																					{elseif $value === null}
																						-
																					{else}
																						{$value}
																					{/if}
																				</td>
																			</tr>
																		{/foreach}
																	</tbody>
																</table>
															</div>
														</div>
													{/if}

													{if ! empty($projectDetail->results)}
														<div class="card mt-4">
															<div class="card-header">
																<h5>Výsledky analýzy</h5>
															</div>
															<div class="card-body">
																<table class="table table-striped">
																	<thead>
																	<tr>
																		<th>Popis</th>
																		<th>Hodnota</th>
																	</tr>
																	</thead>
																	<tbody>
																		<tr>
																			<td>Dimenze (počet sloupců)</td>
																			<td>{$projectDetail->column_count}</td>
																		</tr>
																		<tr>
																			<td>Rozměr (počet řádků)</td>
																			<td>{$projectDetail->row_count}</td>
																		</tr>
																		<tr>
																			<td>Velikost souboru</td>
																			<td>{$projectDetail->file_size} MB</td>
																		</tr>
																		<tr>
																			<td>Délka zpracování</td>
																			<td>{$projectDetail->results->duration|round:2}s</td>
																		</tr>
																		<tr>
																			<td>Počet průchodů/epoch</td>
																			<td>{$projectDetail->results->epochs}</td>
																		</tr>
																		<tr>
																			<td>Počet aktualizovaných vah</td>
																			<td>{$projectDetail->results->total_weight_updates}</td>
																		</tr>
																		<tr>
																			<td>Dosažena kvantizační chyba</td>
																			<td>{$projectDetail->results->best_mqe|round:4}</td>
																		</tr>
																	</tbody>
																</table>
															</div>
														</div>
													{/if}

													
												</div>
												<div class="col-md-6">
													{if ! empty($projectDetail->som_settings)}
														<div class="card mt-4">
															<div class="card-header">
																<h5>Nastavení parametrů SOM</h5>
															</div>
															<div class="card-body">
																<table class="table table-striped">
																	<thead>
																		<tr>
																			<th>Popis</th>
																			<th>Hodnota</th>
																		</tr>
																	</thead>
																	<tbody>
																		{foreach $somConfig as $key => $value}
																			{continueIf ! isset($somConfigDescription[$key])}
																			<tr>
																				<td><strong>{$somConfigDescription[$key]}</strong></td>
																				<td>
																					{if is_array($value)}
																						{implode(', ', $value)}
																					{elseif is_bool($value)}
																						{if $value}Ano{else}Ne{/if}
																					{elseif $value === null}
																						-
																					{else}
																						{$value}
																					{/if}
																				</td>
																			</tr>
																		{/foreach}
																	</tbody>
																</table>
															</div>
														</div>
													{/if}
												</div>
											</div>
										</div>
									</div>

{*									{include ./statsData.latte}*}
									{include ./projectFiles.latte}
									{include ./projectConfigTable.latte}
									<div class="card mt-4">
										<div class="card-body">
											<div class="row">
												{foreach $projectFiles['visualization'] as $type => $files}
													{foreach $files as $file}
														<div class="col-md-4">
															<h5>{$type}</h5>
															<a href="{$basePath}/userFiles/{$projectDetail->uid_hash}/visualization/{$file}" class="thumbnail">
																	<img src="{$basePath}/userFiles/{$projectDetail->uid_hash}/visualization/{$file}" alt="{$type} visualisation" class="img-fluid">
															</a>
														</div>
													{/foreach}
												{/foreach}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


{/block}



