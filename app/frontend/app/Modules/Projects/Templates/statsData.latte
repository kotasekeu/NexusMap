{layout '../../../Common/Templates/@layout.latte'}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			<div class="page-title mb-3">
				<h4>
					Přehled neuronů s daty
					<br /><small class="text-primary">{$projectDetail->name}</small>
				</h4>
			</div>
		</div>
		<div class="container-fluid">
			<div class="row">
				<div class="col-sm-12">
					<div class="card">
						<div class="blog-single card-body">
							<div class="blog-box blog-details">
								<div class="blog-details">
									<p class="text-muted">Zobrazení všech neuronů, které obsahují alespoň jeden záznam. Porovnání lokálních hodnot s globálními ukazuje výjimečnosti jednotlivých clusterů.</p>
									<div class="row mb-4">
										<div class="col-12">
											<div class="card border-danger">
												<div class="card-header text-danger"><strong>Neurony obsahující extrémy</strong></div>
												<div class="card-body table-responsive">

													<table class="table table-sm table-striped table-hover">
														<thead>
														<tr>
															<th>Neuron</th>
															<th>Počet extrémů</th>
															<th>Počet záznamů</th>
															<th>Detail</th>
														</tr>
														</thead>
														<tbody>
														{foreach $extremes['by_cluster'] as $neuronId => $extremeRecords}
															<tr>
																<td>{$neuronId}</td>
																<td>{count($extremeRecords)}</td>
																<td>{$clustersWithData[$neuronId]['count'] ?? '–'}</td>
																<td><a class="btn btn-sm btn-outline-primary" n:href="Projects:cell $projectDetail->project_id, $neuronId">Detail</a></td>
															</tr>
														{/foreach}
														</tbody>
													</table>
												</div>
											</div>


											<div class="card border-danger">
												<div class="card-header text-danger"><strong>Globální statistiky</strong></div>
												<div class="card-body table-responsive">

													<table class="table table-sm table-bordered">
														<thead>
														<tr>
															<th>Proměnná</th>
															<th>Min</th>
															<th>Max</th>
															<th>Průměr</th>
															<th>Medián</th>
														</tr>
														</thead>
														<tbody>
														{foreach $globalStats['numerical'] as $col => $stat}
															<tr>
																<td>{$col}</td>
																<td>{$stat['min']}</td>
																<td>{$stat['max']}</td>
																<td>{$stat['avg']}</td>
																<td>{$stat['median']}</td>
															</tr>
														{/foreach}
														</tbody>
													</table>
												</div>
											</div>


										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

{/block}