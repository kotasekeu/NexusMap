{layout '../../../Common/Templates/@layout.latte'}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			<div class="page-title mb-3 d-flex justify-content-between align-items-center">
				<h4>
					Přehled extrémních hodnot napříč neuronovou mapou
					<br /><small class="text-primary">{$projectDetail->name}</small>
				</h4>
				<a n:href="Projects:detail, project_id => $projectDetail->project_id" class="btn btn-outline-secondary">Zpět na projekt</a>
			</div>
		</div>

		<div class="container-fluid">
			<div class="row">
				<div class="col-sm-12">
					<div class="card border-danger">
						<div class="card-header text-danger"><strong>Všechny extrémní hodnoty v projektu</strong></div>
						<div class="card-body table-responsive">

							<table class="table table-sm table-striped table-hover align-middle">
								<thead>
								<tr>
									<th>Neuron</th>
									{foreach reset($records) as $col => $val}
										<th>{$col}</th>
									{/foreach}
								</tr>
								</thead>
								<tbody>
								{foreach $extremes['by_cluster'] as $neuronId => $uids}
									{foreach $uids as $uid}
										<tr>
											<td>
												<a class="btn btn-xs btn-success" n:href="Projects:cell $projectDetail->project_id, $neuronId">{$neuronId}</a>
											</td>
											{foreach $records[$uid] as $col => $value}
												{var $note = ''}
												{var $class = ''}
												{if isset($globalStats['numerical'][$col])}
													{var $val = floatval($value)}
													{var $min = $globalStats['numerical'][$col]['min']}
													{var $max = $globalStats['numerical'][$col]['max']}
													{var $avg = $globalStats['numerical'][$col]['avg']}
													{if $val === $min}
														{var $note = ' (min)'}
														{var $class = 'text-success fw-bold'}
													{elseif $val === $max}
														{var $note = ' (max)'}
														{var $class = 'text-danger fw-bold'}
													{else}
														{var $delta = round($val - $avg, 2)}
														{if abs($delta) >= 1}
															{var $note = ' (Δ '.$delta.')'}
															{var $class = 'text-muted'}
														{/if}
													{/if}
												{/if}
												<td class="{$class}" style="white-space: nowrap" title="Extrémní hodnota">{$value} <br />{$note}</td>
											{/foreach}
										</tr>
									{/foreach}
								{/foreach}
								</tbody>
							</table>

							<p class="small text-muted mt-2">
								Tabulka zobrazuje extrémní záznamy napříč neuronovou mapou. Barevně jsou označeny hodnoty, které jsou minimem či maximem v celém datasetu. Pokud není hodnota extrémní v tomto smyslu, je uvedena její odchylka od průměru.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{/block}