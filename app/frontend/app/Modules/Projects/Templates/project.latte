<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
		<span class="badge badge-success">Hotovo</span>

		<h5 class="f-w-500">
			První projekt
		</h5><a href="{plink Projects:detail, 1}" class="btn btn-secondary btn-xs">Detail</a>
		<p></p>
		<div class="row details">
			<div class="col-8"><span>Počet dimenzí</span></div>
			<div class="col-4 font-primary">6 </div>
			<div class="col-8"><span>Počet vstupních vektorů</span></div>
			<div class="col-4 font-primary">320 </div>
			<div class="col-8"> <span>Mapa </span></div>
			<div class="col-4 font-primary"> 20x20 Hex</div>
			<div class="col-8"> <span>Délka zpracování</span></div>
			<div class="col-4 font-primary">15,5s</div>
			<div class="col-8"> <span>Počet průchodů/epoch</span></div>
			<div class="col-4 font-primary">35.900</div>
			<div class="col-8"> <span>Počet aktualizovaných vah</span></div>
			<div class="col-4 font-primary">68.320</div>
		</div>

		<div class="project-status mt-4">
			<div class="d-flex mb-0">
				<p>100% </p>
				<div class="flex-grow-1 text-end"><span>Hotovo</span></div>
			</div>
			<div class="progress" style="height: 5px">
				<div class="progress-bar-animated bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
			</div>
		</div>
	</div>
</div>
<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
		<span class="badge badge-success">Hotovo</span>

		<h5 class="f-w-500">
			Iris - Kaggle
		</h5><a href="{plink Projects:detail, 1}" class="btn btn-secondary btn-xs">Detail</a>
		<p></p>
		<div class="row details">
			<div class="col-8"><span>Počet dimenzí</span></div>
			<div class="col-4 font-primary">5 </div>
			<div class="col-8"><span>Počet vstupních vektorů</span></div>
			<div class="col-4 font-primary">150 </div>
			<div class="col-8"> <span>Mapa </span></div>
			<div class="col-4 font-primary"> 10x10 čtverec</div>
			<div class="col-8"> <span>Délka zpracování</span></div>
			<div class="col-4 font-primary">23,45s</div>
			<div class="col-8"> <span>Počet průchodů/epoch</span></div>
			<div class="col-4 font-primary">149.900</div>
			<div class="col-8"> <span>Počet aktualizovaných vah</span></div>
			<div class="col-4 font-primary">298.800</div>
		</div>

		<div class="project-status mt-4">
			<div class="d-flex mb-0">
				<p>100% </p>
				<div class="flex-grow-1 text-end"><span>Hotovo</span></div>
			</div>
			<div class="progress" style="height: 5px">
				<div class="progress-bar-animated bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
			</div>
		</div>
	</div>
</div>
<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
