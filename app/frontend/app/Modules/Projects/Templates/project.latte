		<div class="row details">
			<div class="col-8"><span>Počet dimenzí</span></div>
			<div class="col-4 font-primary">8 </div>
			<div class="col-8"><span>Počet vstupních vektorů</span></div>
			<div class="col-4 font-primary"> 2389</div>
			<div class="col-8"> <span>Mapa </span></div>
			<div class="col-4 font-primary"> 30x30 Hex</div>
		</div>

		<div class="project-status mt-4">
			<div class="d-flex mb-0">
				<p>75% </p>
				<div class="flex-grow-1 text-end"><span>Probíhá</span></div>
			</div>
			<div class="progress" style="height: 5px">
				<div class="progress-bar-animated bg-primary progress-bar-striped" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
			</div>
		</div>
	</div>
</div>
<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
		<span class="badge badge-secondary">Nový</span>

		<h5 class="f-w-500">
			Student Performance Factors
		</h5><a href="{plink Projects:detail, 1}" class="btn btn-secondary btn-xs">Detail</a>
