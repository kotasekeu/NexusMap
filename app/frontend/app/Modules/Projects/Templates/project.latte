<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
		{if $projectDetail->status == 0}
			{if $projectDetail->ready_to_analyze == 1}
				<span class="badge badge-primary">Spuštěno</span>
			{else}
				<span class="badge badge-secondary">Nový</span>
			{/if}
		{elseif $projectDetail->status == 1}
			<span class="badge badge-success">Hotovo</span>
		{elseif  $projectDetail->status == 2}
			<span class="badge badge-primary">Probíhá</span>
		{/if}

		<h5 class="f-w-500">
			<a href="{plink Projects:detail, $projectDetail->project_id}">{$projectDetail->name}</a>
			<br /><em class="small text-secondary">{$projectDetail->uid_hash}</em>
		</h5>
		<p></p>
		<div class="row details">
			<div class="col-12"><strong>Soubor</strong></div>
			<div class="col-8"><span>Dimenze (počet sloupců) </span></div>
			<div class="col-4 text-black">{$projectDetail->column_count} </div>
			<div class="col-8"><span>Rozměr (počet řádků) </span></div>
			<div class="col-4 text-black">{$projectDetail->row_count} </div>
			<div class="col-8"><span>Velikost souboru </span></div>
			<div class="col-4 text-black">{$projectDetail->file_size} MB </div>
			{if isset($projectDetail->project_settings->primary_id)}
				<div class="col-8"><span>Primární sloupec </span></div>
				<div class="col-4 text-black">{$projectDetail->project_settings->primary_id} </div>
			{/if}
			{if ! empty($projectDetail->results)}
				<div class="col-12">
					<strong>Výsledky analýzy</strong>
				</div>
				<div class="col-8"><span>Rozměr mapy </span></div>
				<div class="col-4 font-black"> {$projectDetail->results->map_size[0]}x{$projectDetail->results->map_size[1]} / {$projectDetail->som_settings->map_type}</div>
				<div class="col-8"> <span>Délka zpracování</span></div>
				<div class="col-4 font-black">
					{var $duration = $projectDetail->results->duration}
					{if $duration < 60}
						{$duration|round:0}s
					{elseif $duration < 3600}
						{($duration / 60)|round:1} min
					{else}
						{($duration / 3600)|round:1} hod
					{/if}
				</div>
				{if in_array('expert', $user->roles)}
					<div class="col-8"> <span>Počet průchodů/epoch</span></div>
					<div class="col-4 font-black">{$projectDetail->results->epochs}</div>
					<div class="col-8"> <span>Počet aktualizovaných vah</span></div>
					<div class="col-4 font-black">{$projectDetail->results->total_weight_updates}</div>
					<div class="col-8"> <span>Dosažena kvantizační chyba</span></div>
					<div class="col-4 font-black">{$projectDetail->results->best_mqe|round:4}</div>
				{/if}

			{/if}
		</div>
		<a href="{plink Projects:detail, $projectDetail->project_id}" class="btn btn-success btn-xs">Detail</a>
		<div class="project-status mt-4">
			<div class="d-flex mb-0">
				{if $projectDetail->status == 0}
					{if $projectDetail->ready_to_analyze == 1}
						<p>10% </p>
						<div class="flex-grow-1 text-end"><span>Spuštěno</span></div>
					{else}
						<p>0% </p>
						<div class="flex-grow-1 text-end"><span>Nový</span></div>
					{/if}
				{elseif $projectDetail->status == 2}
					<p>50% </p>
					<div class="flex-grow-1 text-end"><span>Probíhá</span></div>
				{else}
					<p>100% </p>
					<div class="flex-grow-1 text-end"><span>Hotovo</span></div>
				{/if}
			</div>
			<div class="progress" style="height: 5px">
				{if $projectDetail->status == 0}
					{if $projectDetail->ready_to_analyze == 1}
						<div class="progress-bar-animated bg-primary progress-bar-striped" role="progressbar" style="width: 10%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
						<div class="progress-bar-animated bg-success" role="progressbar" style="width: 0%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
					{else}
						<div class="progress-bar-animated bg-primary progress-bar-striped" role="progressbar" style="width: 0%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
						<div class="progress-bar-animated bg-success" role="progressbar" style="width: 0%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
					{/if}
				{elseif $projectDetail->status == 2}
					<div class="progress-bar-animated bg-primary progress-bar-striped" role="progressbar" style="width: 50%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
					<div class="progress-bar-animated bg-success" role="progressbar" style="width: 50%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
				{else}
					<div class="progress-bar-animated bg-success" role="progressbar" style="width: 100%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
				{/if}
			</div>
		</div>
	</div>
</div>
