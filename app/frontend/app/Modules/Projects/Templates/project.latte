<div class="col-xxl-4 col-lg-6 box-col-6">
	<div class="project-box b-light1-primary">
		{if $projectDetail->analysis_done == 1}
			<span class="badge badge-success">Hotovo</span>
		{else}
			<span class="badge badge-primary">Probíhá</span>
		{/if}

		<h5 class="f-w-500">
				{$projectDetail->name}
		</h5><a href="{plink Projects:detail, $projectDetail->project_id}" class="btn btn-secondary btn-xs">Detail</a>
		<p></p>
		<div class="row details">
			<div class="col-6"><span>Soubor - počet sloupců </span></div>
			<div class="col-6 font-primary">12 </div>
			<div class="col-6"> <span>Shluky</span></div>
			<div class="col-6 font-primary">5</div>
			<div class="col-6"> <span>Něco dalšího</span></div>
			<div class="col-6 font-primary">7</div>
		</div>

		<div class="project-status mt-4">
			<div class="d-flex mb-0">
				<p>100% </p>
				<div class="flex-grow-1 text-end"><span>Hotovo</span></div>
			</div>
			<div class="progress" style="height: 5px">
{*				<div class="progress-bar-animated bg-primary progress-bar-striped" role="progressbar" style="width: 70%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>*}
				<div class="progress-bar-animated bg-success" role="progressbar" style="width: 100%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
			</div>
		</div>
	</div>
</div>
