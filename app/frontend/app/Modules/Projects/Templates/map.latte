{layout '../../../Common/Templates/@layout.latte'}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			<div
				id="map"
				class="map"
				style="--cells: {$size};">
				{for $x=0; $x < $size; $x++}
					{for $y=0; $y < $size; $y++}
						<div class="cell">
							{if isset($items[$x.'_'.$y])}
								{var $cnt = $counts[$x.'_'.$y] ?? 0}
								{var $idx = $maxCount ? (int) floor($cnt / $maxCount * (count($colors) - 1)) : 0}

								<a n:href=":cellDetail, y => $y, x => $x" data-coord="{$x}_{$y}" title="položek" style="background-color:{$colors[$idx]|noescape}; color:{$idx > 5 ? 'white' : 'black'};">
									{var $count = count($items[$x.'_'.$y])}
									{$count}
							{else}
								<a class="cell nodata" href="#nodata" data-coord="{$x}_{$y}" title="Žádná data" style="background-color:#FFFFFF;">
							{/if}
							</a>
						</div>
					{/for}
				{/for}
			</div>
			<div id="popup-overlay" class="hidden">
				<div id="popup-content">
					<button id="popup-close">&times;</button>
					<div id="popup-body"></div>
				</div>
			</div>
		</div>
	</div>
	<div id="popup-html" class="hidden">
		asdfasdfasdf
	</div>
{/block}

{block head}
	<style>
		.map {
			display: grid;
			grid-template-columns: repeat(var(--cells), 1fr);
			grid-template-rows:    repeat(var(--cells), 1fr);
			width: 80vmin; height: 80vmin;
		}
		.cell > a {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			height: 100%;
			text-decoration: none;
			color: inherit;
			border:1px #EEE solid;
		}
		.cell a:hover {
			background-color:#DDD !important;
		}
		#popup-overlay {
			position: fixed; inset: 0;
			background: rgba(0,0,0,0.5);
			display: flex; align-items: center; justify-content: center;
			z-index: 1000;
		}
		#popup-content {
			background: #fff;
			border-radius: 4px;
			width: 50vw;
			height: 40vh;
			max-width: 600px;
			max-height: 400px;
			overflow: auto;
			position: relative;
			padding: 1rem;
		}
		#popup-close {
			position: absolute; top: 0.5rem; right: 0.5rem;
			background: none; border: none; font-size: 1.5rem;
			cursor: pointer;
		}
		.hidden { display: none !important; }

        .cell a.nodata:hover {
            background-color:#FFF !important;
        }
	</style>
{/block}

{block scripts}
	<script n:syntax="off">
		const overlay = document.getElementById('popup-overlay');
		const body    = document.getElementById('popup-body');
		const close   = document.getElementById('popup-close');

		document.getElementById('map').addEventListener('click', e => {
		  const a = e.target.closest('a[href]');
		  if (!a) return;
		  e.preventDefault();
		  fetch(a.href)
			.then(r => r.text())
			.then(html => {
			  const parser = new DOMParser();
			  const doc    = parser.parseFromString(html, 'text/html');
			  const popup  = doc.getElementById('popup-html');
			  body.innerHTML = popup ? popup.innerHTML : '';
			  overlay.classList.remove('hidden');
			});
		});

		close.addEventListener('click', () => {
			overlay.classList.add('hidden');
			body.innerHTML = '';
		});

		overlay.addEventListener('click', e => {
			if (e.target === overlay) close.click();
		});
	</script>
{/block}