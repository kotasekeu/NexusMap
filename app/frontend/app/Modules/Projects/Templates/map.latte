{layout '../../../Common/Templates/@layout.latte'}
{block head}
<style>
        body {
            margin: 0;
            padding: 0;
        }
        .map-wrapper {
            position: relative;
            width: 1000px;
            height: 1000px;
            background-image: url('http://nexusmap.l/userFiles/nxmpp68239e46939817.89994944/visualization/hit_map_square.png'); /* exportovaný obrázek heatmapy */
            background-size: cover;
            border: 1px solid #ccc;
			padding:15px;
        }
        .map-container {
            position: relative;
			width:100%;
            height:100%;
        }
        .grid-cell {
            position: absolute;
            width: 10%;
            height: 10%;
            border: 1px solid transparent;
        }
        .grid-cell:hover {
            border: 1px solid rgba(0,0,0,0.3);
            background-color: rgba(255,255,255,0.1);
        }
        .tooltip {
            position: absolute;
            background: white;
            padding: 5px;
            border: 1px solid #ccc;
            font-size: 12px;
            display: none;
            z-index: 10;
        }
	</style>
{/block}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			<div class="map-wrapper">
				<div class="map-container" id="map">

					<div class="tooltip" id="tooltip"></div>
				</div>
			</div>
		</div>
	</div>

{/block}

{block scripts}
	<script n:syntax="off">
		const map = document.getElementById('map');
		const tooltip = document.getElementById('tooltip');
		const gridSize = 10;
		const cellData = {};

		// Fake data
		for (let y = 0; y < gridSize; y++) {
		  for (let x = 0; x < gridSize; x++) {
			const id = `${x}_${y}`;
		const cell = document.createElement('div');
		cell.className = 'grid-cell';
		cell.style.left = `${(x / gridSize) * 100}%`;
		cell.style.top = `${(y / gridSize) * 100}%`;
		cell.dataset.id = id;

		cellData[id] = {
		  vectors: Math.floor(Math.random() * 20),
		  avg: (Math.random() * 10).toFixed(2),
		  extremes: Math.floor(Math.random() * 5)
		};

		cell.addEventListener('mouseenter', e => {
		  const d = cellData[e.target.dataset.id];
		  tooltip.style.left = `${e.pageX + 10}px`;
		  tooltip.style.top = `${e.pageY + 10}px`;
		  tooltip.innerHTML = `Neuron ${e.target.dataset.id}<br>Počet vektorů: ${d.vectors}<br>Průměr: ${d.avg}<br>Extrémy: ${d.extremes}`;
		  tooltip.style.display = 'block';
		});
		cell.addEventListener('mouseleave', () => {
		  tooltip.style.display = 'none';
		});
		cell.addEventListener('click', e => {
		  alert('Přejít na detail clusteru ' + e.target.dataset.id);
		});

		map.appendChild(cell);
	  }
	}
	</script>
{/block}