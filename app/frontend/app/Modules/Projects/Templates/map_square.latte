{layout '../../../Common/Templates/@layout.latte'}
{block head}
	<link rel="stylesheet" type="text/css" href="{$baseUrl}/assets/css/map.css">
{/block}

{block content}
	<div class="page-body">
		<div class="container-fluid">
			{if $mapName === 'mqe-history'}
				{* Pro mqe-history se legenda tímto způsobem nezobrazuje, jedná se o graf historie *}
				<div class="map-container square-map" style="background-image: url('{$baseUrl}/userFiles/{$projectDetail->uid_hash}/visualization/{$mapName}.png');"></div>
			{else}
				<div class="map-layout-wrapper">
					<div class="map-visual-wrapper">
						<div class="map-container square-map grid-size-{$projectDetail->som_settings->m}" data-size="{$projectDetail->som_settings->m|noescape}" id="map" style="background-image: url('{$baseUrl}/userFiles/{$projectDetail->uid_hash}/visualization/{$mapName}.png');">
							{* Mřížkové buňky budou dynamicky přidány pomocí JavaScriptu zde *}
						</div>
					</div>
					<div class="legend-static-wrapper" id="legendStaticWrapper" style="display: none;">
						<img id="legendStaticImage" src="{$baseUrl}/userFiles/{$projectDetail->uid_hash}/visualization/legends/{$mapName}.png" alt="Legenda - {$mapName}" class="legend-static-image">
					</div>
				</div>
				<div class="map-tooltip" id="tooltip"></div>
			{/if}
		</div>
	</div>
{/block}

{block scripts}
	{if $mapName !== 'mqe-history'}
		<script>
			// Existující skript pro interakci s mapou a tooltipy
			$(function() {
				const $map = $('#map');
				const $tooltip = $('#tooltip');
				const gridSize = {$projectDetail->som_settings->m};
				const cellData = {$clustersWithData|noescape};
				const cellLinkJs = {$cellLink};
				let tooltipTimeout;

				function showTooltip(cell, event) {
					clearTimeout(tooltipTimeout);
					const d = cellData[$(cell).data('id')];
					if (!d) {
						$tooltip.hide();
						return;
					}

					let tooltipContent = `<strong>Neuron</strong> ${ $(cell).data('id')}<br/><br />`;
					tooltipContent += `<strong>Počet záznamů:</strong> ${ d.records_counts}<br/>`;
					tooltipContent += `<strong>Počet extrémů:</strong> ${ d.extremes_counts}<br/>`;
					tooltipContent += '<br><strong>Průměrné hodnoty:</strong><br>';
					
					for (const [key, value] of Object.entries(d.numerical_stats)) {
						tooltipContent += `<strong>${ key}:</strong> ${ value.toFixed(2)}<br/>`;
					}

					$tooltip
						.html(tooltipContent)
						.css({
							'left': event.clientX,
							'top': event.clientY
						})
						.stop(true, true)
						.show();
				}

				function hideTooltip() {
					tooltipTimeout = setTimeout(() => {
						$tooltip.hide();
					}, 100);
				}

				// Vytvoření mřížky - i je řádek (y), j je sloupec (x)
				for (let i = 0; i < gridSize; i++) {
					for (let j = 0; j < gridSize; j++) {
						const id = `${ i}_${ j}`; // ID ve formátu "řádek_sloupec"
						const $cell = $('<div/>', {
							'class': 'grid-cell',
							'data-id': id
						}).css({
							'left': `${ (j / gridSize) * 100}%`, // j určuje x-ovou pozici
							'top': `${ (i / gridSize) * 100}%`   // i určuje y-ovou pozici
						});

						// Přidání třídy pro červený rámeček, pokud neuron obsahuje extrémy
						const neuronData = cellData[id];
						if (neuronData && neuronData.extremes_counts > 0) {
							$cell.addClass('has-extremes');
						}

						$cell
							.on('mouseenter', function(e) {
								showTooltip(this, e);
							})
							.on('mouseleave', hideTooltip)
							.on('click', function() {
								const cellId = $(this).data('id');
								if (cellLinkJs) {
									window.location.href = cellLinkJs + "&cell_id=" + cellId;
								} else {
									alert('Chybí odkaz pro detail buňky.');
								}
							});
						$map.append($cell);
					}
				}

				// Aktualizace pozice tooltipu při pohybu myši
				$map.on('mousemove', 'div.grid-cell', function(e) {
					if($tooltip.is(':visible')) {
						$tooltip.css({
							'left': e.clientX,
							'top': e.clientY
						});
					}
				});
			});

			// Nový skript pro zobrazení legendy
			document.addEventListener('DOMContentLoaded', function() {
				const legendImage = document.getElementById('legendStaticImage');
				const legendWrapper = document.getElementById('legendStaticWrapper');
				const mapElement = document.getElementById('map'); // Přidáme referenci na mapu

				if (legendImage && legendWrapper && mapElement) {
					const legendSrc = legendImage.getAttribute('src');
					if (legendSrc) {
						fetch(legendSrc)
							.then(response => {
								if (response.ok) {
									legendWrapper.style.display = 'block'; // Zobrazí legendu, pokud obrázek existuje
									
									// Nastavení max-height legendy podle výšky mapy
									const mapHeight = mapElement.offsetHeight;
									legendImage.style.maxHeight = mapHeight + 'px';
									
								} else {
									legendWrapper.style.display = 'none'; // Skryje, pokud obrázek není nalezen (např. 404)
								}
							})
							.catch(error => {
								legendWrapper.style.display = 'none'; // Skryje i v případě síťové chyby
								console.error('Chyba při načítání obrázku legendy:', error);
							});
					} else {
						legendWrapper.style.display = 'none'; // Skryje, pokud src atribut obrázku je prázdný
					}
				}
			});
		</script>
	{/if}
{/block}