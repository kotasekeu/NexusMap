# WARNING: it is CRITICAL that this file & directory are NOT accessible directly via a web browser!
# http://nette.org/security-warning

php:
	date.timezone: Europe/Prague

application:
#	catchExceptions: yes

	errorPresenter:
		4xx: Api\Errors\Error4xx   # for Nette\Application\BadRequestException
		5xx: Api\Errors\Error5xx   # for other exceptions

	mapping:
		Api: Api\Presenters\*Presenter

extensions:
	dibi: Dibi\Bridges\Nette\DibiExtension22

services:
	- Api\Router\RouterFactory::createRouter

	oauth2Server:
		factory: League\OAuth2\Server\AuthorizationServer(
			@oauth2RepositoryAccessToken,
			@oauth2RepositoryClient,
			@oauth2RepositoryScope,
			@oauth2RepositoryAuthCode,
			@oauth2CryptKey
		)

	oauth2RepositoryAccessToken: Api\Security\Repositories\AccessTokenRepository
	oauth2RepositoryClient: Api\Security\Repositories\ClientRepository
	oauth2RepositoryScope: Api\Security\Repositories\ScopeRepository
	oauth2RepositoryAuthCode: Api\Security\Repositories\AuthCodeRepository
	oauth2CryptKey: League\OAuth2\Server\CryptKey(%oauth_private_key%, null, false)


