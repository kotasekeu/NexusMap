openapi: 3.0.0
info:
	title: API
	version: 1.0.0
servers:
	- url: http://api.nexusmap.l:8080/v1
paths:

	/login:
		post:
			summary: Login and get API token
			tags: ["Auth"]
			requestBody:
				required: true
				content:
					application/json:
						schema:
							type: object
							properties:
								username:
									type: string
									example: "tomas"
								password:
									type: string
									example: "vokurka"
			responses:
				'200':
					description: Successfully logged in
					content:
						application/json:
							schema:
								type: object
								properties:
									token:
										type: string
										example: "abc123"

	/customers:
		get:
			summary: Get list of all customers
			tags: ["Customers"]
			security:
				- bearerAuth: []
			responses:
				'200':
					description: List of customers
					content:
						application/json:
							schema:
								type: array
								items:
									$ref: '#/components/schemas/Customer'
				'401':
					description: Unauthorized - invalid or missing token
		
	'/customers/{id}':
		get:
			summary: Get customer by ID
			tags: ["Customers"]
			security:
				- bearerAuth: []
			parameters:
				- name: id
					in: path
					required: true
					schema:
						type: integer
			responses:
				'200':
					description: Customer detail
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Customer'
				'401':
					description: Unauthorized - invalid or missing token
				'404':
					description: Customer not found

	'/customers/email/{email}':
		get:
			summary: Find customer by email
			tags: ["Customers"]
			security:
				- bearerAuth: []
			parameters:
				- name: email
					in: path
					required: true
					schema:
						type: string
			responses:
				'200':
					description: Customer detail
					content:
						application/json:
							schema:
								$ref: '#/components/schemas/Customer'
				'401':
					description: Unauthorized - invalid or missing token
				'404':
					description: Customer not found
	

components:
	schemas:
		Customer:
			type: object
			properties:
				rowId:
					type: integer
					description: Unique row identifier
				customerId: 
					type: integer
					description: Customer identifier
				name:
					type: string
					description: Customer's name
				email:
					type: string
					description: Customer's email address
				password:
					type: string
					description: Customer's password
				company:
					type: string
					nullable: true
					description: Customer's company name
				monthlyTokens:
					type: integer
					description: Number of tokens allocated monthly
				remainingTokens:
					type: integer 
					description: Number of tokens remaining
				typeId:
					type: integer
					description: Customer type identifier
				customerType:
					$ref: '#/components/schemas/CustomerType'

		CustomerType:
			type: object
			properties:
				typeId:
					type: integer
					description: Unique identifier of customer type
				code:
					type: string
					description: Code identifier of customer type
				label:
					type: string
					description: Display label of customer type
#
