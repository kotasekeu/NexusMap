<?xml version="1.0"?>
<ruleset name="ERP">
	<description>Kódování podle PSR-12 s taby místo mezer</description>

	<!-- Použití standardů -->
	<rule ref="PSR12"/>

	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" type="integer" value="1"/>
			<property name="tabIndent" type="boolean" value="true"/>
		</properties>
	</rule>

	<!-- Zakáže pravidlo PSR-12, které vynucuje mezery -->
	<rule ref="PSR12.ControlStructures.ControlStructureSpacing"/>
	<rule ref="PSR12.ControlStructures.NewlineAfterOpenBrace"/>
	<rule ref="PSR12.Functions.MethodDeclaration"/>
	<rule ref="PSR12.WhiteSpace.ScopeIndent">
		<properties>
			<property name="tabIndent" type="boolean" value="true"/>
		</properties>
	</rule>

	<!-- Složky, které analyzovat -->
	<file>app</file>
	<file>tests</file>

	<!-- Vyloučení složek -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>var/*</exclude-pattern>
	<exclude-pattern>log/*</exclude-pattern>
</ruleset>