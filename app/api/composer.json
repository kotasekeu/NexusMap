{
"name": "kotasekeu/nexusmapapi",
    "description": "This project offers a data analysis tool using Self-Organizing Maps (SOM) to simplify complex datasets into clear topologies, revealing key patterns for informed decision-making. It includes a user-friendly interface for easy interaction and result visualization, suitable for both technical and non-technical users.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tomas kotasek",
            "email": "tomas@kotasek.eu"
        }
    ],
    "require": {
        "php": ">=8.4",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/caching": "^3.3",
        "nette/di": "^3.2",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/mail": "^4.0",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "latte/latte": "^3.0",
        "tracy/tracy": "^2.10",
        "nette/robot-loader": "^4.0",
        "dibi/dibi": "^5.0",
        "swagger-api/swagger-ui": "^5.20",
        "league/oauth2-server": "^8.4"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "./app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "../../tests"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
